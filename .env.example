# === WAJIB ===
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# === OPSIONAL ===
# ID chat admin (angka) untuk menerima laporan error. Kosongkan = error hanya ke console.
# Bisa lebih dari satu, pisahkan koma. Contoh: ADMIN_CHAT_IDS=123456789,987654321
ADMIN_CHAT_IDS=

# Mode jalan: "polling" (default, gampang) atau "webhook" (butuh URL publik + PORT)
BOT_MODE=polling
PORT=3000
# Wajib diisi kalau BOT_MODE=webhook — URL publik tanpa trailing slash, mis. https://bot.example.com
PUBLIC_URL=
