# === WAJIB ===
BOT_TOKEN=ISI_TOKEN_DARI_BOTFATHER
# Mode: polling (dev) atau webhook (produksi)
BOT_MODE=polling

# === Webhook (diperlukan bila BOT_MODE=webhook) ===
PUBLIC_URL=https://simulasi-cpns-bot.likrea.biz.id
PORT=18743

# === Admin: daftar Telegram user ID, pisahkan koma ===
ADMIN_CHAT_IDS=

# === Database (opsional; default: ./data/data.db) ===
# DB_PATH=/home/sodik-tunnel/cpns-bot/data/data.db

# === Passing grade SKD (default SKD 2024) ===
PASS_TWK=65
PASS_TIU=80
PASS_TKP=166

# === Timer simulasi: detik per soal (default 72 = 12 menit utk 10 soal) ===
DURASI_PER_SOAL_DETIK=72
